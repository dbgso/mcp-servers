{
  // Type-checks the TypeScript that runs under `tsx` and so is never compiled:
  // the database smoke scripts and the kit they share. `tsx` strips types and
  // runs, so without this a type error surfaces only as a failing CI step --
  // or not at all, on a branch of the script the run did not take.
  //
  // Bare imports resolve from each file's own package, so one config covers
  // every package's scripts. Workspace dependencies resolve to their built
  // `dist/*.d.ts`: run `pnpm build` first.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "ci/db/*.mts",
    "packages/db-read-mcp/scripts/*.ts",
    "packages/mcp-shared-db-mysql/scripts/*.ts",
    "packages/mcp-shared-db-postgres/scripts/*.ts",
    "packages/mcp-shared/scripts/*.ts"
  ]
}
