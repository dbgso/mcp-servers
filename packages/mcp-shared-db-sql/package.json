{
  "name": "mcp-shared-db-sql",
  "version": "0.1.0",
  "private": true,
  "description": "Engine-agnostic parameterized SQL builder + Dialect interface for mcp-shared-db DataSource implementations",
  "type": "module",
  "main": "dist/index.js",
