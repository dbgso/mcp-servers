{
  "name": "mcp-shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared types and utilities for MCP servers",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./duckdb": {
      "types": "./dist/duckdb.d.ts",
      "import": "./dist/duckdb.js"
    },
    "./approval": {
      "types": "./dist/approval.d.ts",
      "import": "./dist/approval.js"
    },
    "./tunnel": {
      "types": "./dist/tunnel.d.ts",
      "import": "./dist/tunnel.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint src/"
  },
  "keywords": [
    "mcp",
    "shared",
    "types",
    "utilities"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "catalog:"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@types/node-notifier": "8.0.5",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@duckdb/node-api": "catalog:",
    "node-notifier": "10.0.1",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  }
}
