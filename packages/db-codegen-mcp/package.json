{
  "name": "db-codegen-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server: read-only DB schema introspection + metadata.ts / selectable-fields.ts codegen",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "db-codegen-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup && node ../../scripts/verify-bundle.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "codegen",
    "database",
    "postgres",
    "metadata",
    "introspection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbgso/mcp-servers.git",
    "directory": "packages/db-codegen-mcp"
  },
  "homepage": "https://github.com/dbgso/mcp-servers/tree/main/packages/db-codegen-mcp#readme",
  "bugs": {
    "url": "https://github.com/dbgso/mcp-servers/issues?labels=pkg:db-codegen-mcp"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "pg": "8.11.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "mcp-shared": "workspace:*",
    "mcp-shared-db-codegen": "workspace:*",
    "mcp-shared-secrets": "workspace:*",
    "tsup": "catalog:",
    "vitest": "catalog:"
  }
}
