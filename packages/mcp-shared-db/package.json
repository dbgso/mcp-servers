{
  "name": "mcp-shared-db",
  "version": "0.1.0",
  "private": true,
  "description": "Engine-agnostic relational describe-execute operation library for MCP servers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mcp-shared": "workspace:*",
    "mcp-shared-db-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "mcp-shared-db-postgres": "workspace:*",
    "vitest": "catalog:"
  }
}
