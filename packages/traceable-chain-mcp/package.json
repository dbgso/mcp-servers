{
  "name": "traceable-chain-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server and CLI for traceable decision chains: philosophy → requirement → spec → design → implementation → code, with drift detection",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "traceable-chain-mcp": "dist/index.js",
    "traceable-chain": "dist/bin/traceable-chain.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "cli": "tsx src/bin/traceable-chain.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "traceable",
    "document",
    "chain",
    "workflow"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "mcp-shared": "workspace:*",
    "ulid": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
