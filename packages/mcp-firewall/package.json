{
  "name": "mcp-firewall",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-based firewall for MCP servers - allow, deny, or require approval for tool calls",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-firewall": "./dist/index.js"
  },
  "files": [
    "dist",
    "presets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup && node ../../scripts/verify-bundle.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "firewall",
    "proxy",
    "filter",
    "security",
    "rules",
    "claude",
    "ai",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbgso/mcp-servers.git",
    "directory": "packages/mcp-firewall"
  },
  "homepage": "https://github.com/dbgso/mcp-servers/tree/main/packages/mcp-firewall#readme",
  "bugs": {
    "url": "https://github.com/dbgso/mcp-servers/issues?labels=pkg:mcp-firewall"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "minimatch": "10.0.1",
    "node-notifier": "catalog:",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "git-repo-explorer-mcp": "workspace:*",
    "mcp-shared": "workspace:*",
    "tsup": "catalog:",
    "vitest": "catalog:"
  }
}
