{
  "name": "mcp-shared-dynamodb",
  "version": "0.1.0",
  "private": true,
  "description": "DynamoDB describe-execute operation library for MCP servers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "mcp-shared": "workspace:*",
    "mcp-shared-db-core": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "3.1041.0",
    "@aws-sdk/lib-dynamodb": "3.1041.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/lib-dynamodb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
