{
  "mcpServers": {
    "playwright-proxy": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": [
        "npx", "tsx",
        "./packages/mcp-firewall/src/index.ts",
        "--command", "npx",
        "--args", "@playwright/mcp",
        "--rules-file", "./packages/mcp-firewall/playwright-rules.json"
      ]
    },
    "git-repo-explorer-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/git-repo-explorer-mcp/src/index.ts", "/tmp/mcp-git-repos", "--remind-mcp"]
    },
    "interactive-instruction-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./docs", "--remind-mcp", "--topic-for-every-task", "every-task"]
    },
    "interactive-pdca-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-pdca-mcp/src/index.ts", "./docs", "--remind-mcp", "--topic-for-every-task", "every-task"]
    },
    "traceable-chain-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/traceable-chain-mcp/src/index.ts", "./packages/traceable-chain-mcp/docs/chain"]
    },
    "kroki-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/kroki-mcp/src/index.ts"]
    },
    "ast-file-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/ast-file-mcp/src/index.ts"]
    },
    "ast-typescript-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/ast-typescript-mcp/src/index.ts"]
    },
    "python-diagrams-mcp": {
      "command": "sh",
      "args": ["-c", "docker run --rm -i -v \"${PWD}/output:/output\" --user \"$(id -u):$(id -g)\" python-diagrams-mcp:latest"]
    },
    "graph-math-mcp": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "graph-math-mcp:latest"]
    },
    "ast-file-mcp-docs": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./packages/ast-file-mcp/docs"]
    },
    "ast-typescript-mcp-docs": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./packages/ast-typescript-mcp/docs"]
    },
    "git-repo-explorer-mcp-docs": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./packages/git-repo-explorer-mcp/docs"]
    },
    "interactive-pdca-mcp-docs": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./packages/interactive-pdca-mcp/docs"]
    },
    "kroki-mcp-docs": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./packages/kroki-mcp/docs"]
    },
    "traceable-chain-mcp-docs": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./packages/traceable-chain-mcp/docs"]
    },
    "interactive-instruction-mcp-docs": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/interactive-instruction-mcp/src/index.ts", "./packages/interactive-instruction-mcp/docs"]
    },
    "excel-mcp": {
      "command": "npx",
      "args": ["--yes", "@negokaz/excel-mcp-server"]
    },
    "duckdb-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/duckdb-mcp/src/index.ts"]
    },
    "cli-to-mcp": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/cli-to-mcp/src/index.ts"]
    },
    "cli-proxy": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": [
        "npx", "tsx", "./packages/mcp-firewall/src/index.ts",
        "--command", "npx",
        "--args", "tsx ./packages/cli-to-mcp/src/index.ts",
        "--rules-file", "./packages/cli-to-mcp/aws-rules.json"
      ]
    },
    "mcp-lab": {
      "command": "./scripts/wait-for-session-setup.sh",
      "args": ["npx", "tsx", "./packages/mcp-lab/src/index.ts"]
    }
  }
}
