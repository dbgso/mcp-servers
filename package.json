{
  "name": "mcp-servers",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for MCP servers",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r --parallel exec sh -c 'rm -rf dist tsconfig.tsbuildinfo'",
    "typecheck": "pnpm build && pnpm -r --parallel exec sh -c '[ -f tsconfig.json ] || exit 0; exec tsc --noEmit' && pnpm typecheck:scripts",
    "typecheck:scripts": "node scripts/typecheck-package-scripts.mjs",
    "lint:deps": "syncpack lint && node scripts/check-peer-floors.mjs",
    "test:lint-rules": "node --test eslint-rules/__tests__/*.test.mjs",
    "lint": "oxlint --type-aware packages/*/src packages/*/scripts ci/db",
    "test": "pnpm -r test",
    "coverage": "pnpm -r --parallel exec vitest run --coverage",
    "dev": "pnpm -r --parallel dev",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && node scripts/verify-changelog-gate.mjs && changeset publish",
    "lint:duplication": "jscpd"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "jscpd": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "syncpack": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  }
}
