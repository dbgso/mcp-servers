# Connection for the MySQL smoke test, against the container in compose.yaml.
#
# These credentials are a local fixture, checked in on purpose so the smoke
# test runs with no setup. The database exists only inside docker on the
# machine running the tests; the password guards nothing.
#
# Port 53306 rather than 3306 so this never collides with a MySQL the
# developer is already running.
DBGEN_URL=mysql://smoke:smoke@127.0.0.1:53306/smoke
