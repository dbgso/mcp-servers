# SSH tunnel smoke test against the compose bastion + postgres.
#
# The host and port here are what the *bastion* resolves, not what this machine
# resolves: `postgres` is a name on the container network. That is deliberate —
# if the tunnel is not carrying the connection, nothing else can answer.
DBREAD_URL=postgres://smoke:smoke@postgres:5432/smoke
DBREAD_BASTION_HOST=smoke@127.0.0.1
# Relative to this file; the smoke script resolves it that way so the value
# does not depend on which directory the runner happens to be in.
DBREAD_BASTION_KEY=../ssh/id_ed25519
# Non-standard port, and a host key that is new every run because the container is.
DBREAD_BASTION_SSH_ARGS=-p 52222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
