# Does `drafts` survive the merged inputSchema? The handler tests call the
# handler; only a real call crosses the tool boundary that assembles one
# schema out of every action's shape.
{"server": {"args": ["{{TMPDIR}}"], "env": {"IIMCP_LINT_MAX_LINES": "3"}}}

{"call": "instruction", "label": "no drafts yet", "args": {"action": "list", "drafts": true}, "expect": ["No drafts."], "expectNot": ["Unrecognized", "invalid_type", "Unknown action"]}
{"call": "instruction", "label": "add two", "args": {"action": "add", "id": "one", "content": "# One", "description": "First", "whenToUse": ["w"]}, "expect": ["created"]}
{"call": "instruction", "label": "add another", "args": {"action": "add", "id": "two", "content": "# Two", "description": "Second", "whenToUse": ["w"]}, "expect": ["created"]}
{"call": "instruction", "label": "both listed by plain id, with the ids approve takes", "args": {"action": "list", "drafts": true}, "expect": ["2 draft(s)", "one", "two"], "expectNot": ["_mcp_drafts"]}
{"call": "instruction", "label": "the ordinary listing still hides them", "args": {"action": "list", "recursive": true}, "expectNot": ["one", "two"]}
{"call": "instruction", "label": "it offers the self-review they need, not a batch that would be refused", "args": {"action": "list", "drafts": true}, "expect": ["Awaiting self-review", "notes:"], "expectNot": ["ids:"]}
{"call": "instruction", "label": "combining it with a filter is refused rather than answered wrongly", "args": {"action": "list", "drafts": true, "query": "one"}, "expect": ["takes no other filter"]}
{"call": "instruction", "label": "a draft with something for lint to find", "args": {"action": "add", "id": "repeats", "content": "## Related\n\nOne.\n\n## Related\n\nTwo.", "description": "A draft with a heading that comes back", "whenToUse": ["w"]}, "expect": ["duplicate-heading"]}
{"call": "instruction", "label": "lint holds a draft to its own rules", "args": {"action": "lint"}, "expect": ["repeats (draft)", "duplicate-heading"], "expectNot": ["orphaned-document", "similar-documents"]}
{"call": "instruction", "label": "graph says a draft is out of scope, not missing", "args": {"action": "graph", "id": "one"}, "expect": ["is a draft"], "expectNot": ["not found"]}
{"call": "instruction", "label": "set_status on an id that is nowhere", "args": {"action": "set_status", "id": "nowhere", "status": "editing"}, "expect": ["not found"]}
{"call": "instruction", "label": "promote one, so there is a promoted id to try", "args": {"action": "approve", "id": "one", "notes": "reviewed"}, "expect": ["user_reviewing"]}
{"call": "instruction", "label": "  attempt 1", "args": {"action": "approve", "id": "one", "explanation": "Promoting so the promoted cases are reachable.", "force": true}, "expect": ["Not Yet"]}
{"call": "instruction", "label": "  attempt 2", "args": {"action": "approve", "id": "one", "explanation": "Promoting so the promoted cases are reachable.", "force": true}, "expect": ["promoted"]}
{"call": "instruction", "label": "set_status on a promoted document says why, not that it is missing", "args": {"action": "set_status", "id": "one", "status": "editing"}, "expect": ["no workflow state to reset"], "expectNot": ["not found"]}
{"call": "instruction", "label": "approve on a promoted document says the same", "args": {"action": "approve", "id": "one", "notes": "reviewed again"}, "expect": ["already promoted"], "expectNot": ["not found"]}
{"call": "instruction", "label": "and so does the batch form", "args": {"action": "approve", "ids": "one", "explanation": "Both."}, "expect": ["already promoted"]}

# `targetId` renames the document a draft is promoted as. The batch path never
# received it, so it was dropped in silence and the drafts landed under their own
# ids while the caller had asked for another.
{"call": "instruction", "label": "a batch cannot take a single targetId", "args": {"action": "approve", "ids": "one,two", "targetId": "renamed", "explanation": "Promoting both under one name, which is the thing that cannot work."}, "expect": ["cannot apply to a batch of 2"], "expectNot": ["Not Yet"]}
{"call": "instruction", "label": "nor a single notes", "args": {"action": "approve", "ids": "one,two", "notes": "Reviewed both, which is the review not having happened."}, "expect": ["cannot stand for a batch of 2"], "expectNot": ["Not Yet"]}
{"call": "instruction", "label": "nor force, whose alternative is this call", "args": {"action": "approve", "ids": "one,two", "force": true, "explanation": "Both drafts for the audit."}, "expect": ["nothing here for it to skip"], "expectNot": ["Not Yet"]}
